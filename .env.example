# Copie para .env e preencha. Nunca commitar o .env. Web (Vercel) e worker (PC local) leem as mesmas chaves.

# ── Supabase (Auth + Postgres; tabelas no schema "ads") ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Pooler em MODO TRANSAÇÃO (…pooler.supabase.com:6543): web e worker (o código manda uma consulta por vez por conexão).
DATABASE_URL=
# Pooler em MODO SESSÃO (…:5432): só as migrations (pnpm db:migrate). Tem só 15 clientes no projeto inteiro.
DIRECT_URL=

# ── Segurança ─────────────────────────────────────────────────────────────────
# 64 caracteres hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Cifra os tokens da Meta/Google. Trocar invalida as conexões salvas (reconectar).
TOKEN_ENCRYPTION_KEY=
# E-mails (separados por vírgula) que administram a plataforma: contas de IA do worker.
ADMIN_EMAILS=

# ── Meta Ads ──────────────────────────────────────────────────────────────────
# Opcional: com o App Secret, toda chamada leva appsecret_proof.
META_APP_SECRET=
META_API_VERSION=v26.0

# ── Google Ads ────────────────────────────────────────────────────────────────
# opcional: o Google ignora o developer token desde set/2026 (acesso vem do projeto do Google Cloud)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# ID da conta MCC (gerente), sem traços, se as contas forem acessadas por ela.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25

# ── Worker local ──────────────────────────────────────────────────────────────
WORKER_ID=pc-local
# Pasta das contas de IA e das conversas (padrão: .worker-data na raiz do projeto)
WORKER_DATA_DIR=
WORKER_CONCURRENCY=3
# Sincronização automática de cada conexão, em minutos
SYNC_INTERVAL_MIN=60
# Opcionais: modelo fixo e tempo máximo por resposta
AI_CLAUDE_MODEL=
AI_CODEX_MODEL=
AI_TURN_TIMEOUT_MS=600000

# ── Reservado para o MVP 3 (Video Studio): R2 e Resend já ficam configurados ──
RESEND_API_KEY=
# Remetente e link dos e-mails de aviso do worker (WhatsApp caiu). Vão para ADMIN_EMAILS.
EMAIL_FROM=DOMUS AdPilot <avisos@digitaldomus.com.br>
APP_PUBLIC_URL=https://adpilot.digitaldomus.com.br
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Video Studio: Python 3.10+ usado para criar o venv da voz local (Kokoro). Padrão: "python" do PATH.
PYTHON_BIN=

# ── Armazenamento de mídia ───────────────────────────────────────────────────
# r2 = Cloudflare R2 (o site online lê de lá). local = disco do PC (web e worker no mesmo PC).
STORAGE=r2
# Só para STORAGE=local ou pnpm media:migrar: pasta dos vídeos/áudios no PC (caminho absoluto)
MEDIA_DIR=D:\DOMUS-AdPilot-Media
# Arquivo morto: pasta do Google Drive para computador. Cópia de tudo que o worker gera; o excesso do R2 fica só aqui.
DRIVE_DIR=G:\Meu Drive\AdPilot
# Máximo que o AdPilot ocupa no R2 (o bucket é dividido com a Domus; grátis até 10 GB)
R2_LIMITE_GB=6

# WhatsApp (Wuzapi local, infra/whatsapp)
WUZAPI_URL=http://localhost:8081
WUZAPI_ADMIN_TOKEN=
WUZAPI_TOKEN=
WUZAPI_ENCRYPTION_KEY=
